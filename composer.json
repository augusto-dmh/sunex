{
    "$schema": "https://getcomposer.org/schema.json",
    "name": "augusto-dmh/sunex",
    "type": "project",
    "description": "People management for Brazilian companies: dated employment history, CLT férias and afastamentos, and AI agents you can audit.",
    "keywords": [
        "laravel",
        "hr",
        "people-management",
        "clt",
        "esocial"
    ],
    "license": "AGPL-3.0-only",
    "require": {
        "php": "^8.4",
        "inertiajs/inertia-laravel": "^3.0",
        "laravel/chisel": "^0.1.0",
        "laravel/fortify": "^1.37.2",
        "laravel/framework": "^13.17",
        "laravel/tinker": "^3.0",
        "laravel/wayfinder": "^0.1.14"
    },
    "require-dev": {
        "driftingly/rector-laravel": "^2.6",
        "fakerphp/faker": "^1.24",
        "larastan/larastan": "^3.9",
        "laravel/boost": "^2.2",
        "laravel/pail": "^1.2.5",
        "laravel/pao": "^1.0.6",
        "laravel/pint": "^1.27",
        "laravel/sail": "^1.53",
        "mockery/mockery": "^1.6",
        "nunomaduro/collision": "^8.9.3",
        "pestphp/pest": "^5.3",
        "pestphp/pest-plugin-laravel": "^5.0",
        "rector/rector": "^2.6"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "Database\\Factories\\": "database/factories/",
            "Database\\Seeders\\": "database/seeders/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "setup": [
            "composer install",
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\"",
            "@php artisan key:generate",
            "docker compose up -d --wait",
            "@php artisan migrate --force",
            "npm install",
            "npm run build"
        ],
        "dev": [
            "Composer\\Config::disableProcessTimeout",
            "@php artisan dev"
        ],
        "lint": [
            "Composer\\Config::disableProcessTimeout",
            "pint --parallel --test"
        ],
        "lint:fix": [
            "pint --parallel"
        ],
        "analyse": [
            "Composer\\Config::disableProcessTimeout",
            "phpstan analyse --no-progress"
        ],
        "refactor-check": [
            "Composer\\Config::disableProcessTimeout",
            "rector process --dry-run --no-progress-bar"
        ],
        "refactor": [
            "rector process"
        ],
        "test": [
            "Composer\\Config::disableProcessTimeout",
            "@php artisan config:clear --ansi",
            "@php artisan test"
        ],
        "frontend-check": [
            "Composer\\Config::disableProcessTimeout",
            "@php artisan wayfinder:generate --with-form --ansi",
            "npm run check -- resources",
            "npm run types:check",
            "npm run build"
        ],
        "check": [
            "Composer\\Config::disableProcessTimeout",
            "@lint",
            "@analyse",
            "@refactor-check",
            "@test",
            "@frontend-check"
        ],
        "post-autoload-dump": [
            "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
            "@php artisan package:discover --ansi"
        ],
        "post-update-cmd": [
            "@php artisan vendor:publish --tag=laravel-assets --ansi --force",
            "@php artisan boost:update --ansi"
        ],
        "post-root-package-install": [
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\""
        ],
        "post-create-project-cmd": [
            "@php artisan key:generate --ansi",
            "@php artisan migrate --graceful --ansi"
        ],
        "pre-package-uninstall": [
            "Illuminate\\Foundation\\ComposerScripts::prePackageUninstall"
        ]
    },
    "scripts-descriptions": {
        "setup": "Install dependencies, start PostgreSQL, migrate and build the frontend",
        "lint": "Check PHP code style with Pint (no changes)",
        "lint:fix": "Fix PHP code style with Pint",
        "analyse": "Run Larastan static analysis",
        "refactor-check": "Check that Rector has nothing to change (dry run)",
        "refactor": "Apply Rector refactorings",
        "test": "Run the Pest suite (unit, feature and architecture) on PostgreSQL",
        "frontend-check": "Lint, type-check and build the frontend",
        "check": "Run every quality gate, as CI does"
    },
    "extra": {
        "laravel": {
            "dont-discover": [],
            "installer": {
                "post-create-project": []
            }
        }
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "php-http/discovery": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
